test('Organização', detectarCargaNecessaria('Qual guilda você pertence?').organizacao === true);
test('Profissão', detectarCargaNecessaria('O que você faz da vida?').profissao === true);
test('Regras', detectarCargaNecessaria('O que você faria nessa situação?').regras_interpretacao === true);
test('Lacunas', detectarCargaNecessaria('Conte sobre sua infância').lacunas_narrativas === true);

// =============================================
// TESTES INTERPRETADOR DE CONVERSA
// =============================================
console.log('\n=== TESTE INTERPRETADOR DE CONVERSA ===');

const interp1 = interpretarConversa('Oi, tudo bem?', { historico: [] });
test('Casual: intenção', interp1.intencao.tipoIntencao === 'afirmacao' || interp1.intencao.tipoIntencao === 'pergunta');

const interp2 = interpretarConversa('Você sente saudade de alguém?', { historico: [] });
test('Emocional: assunto', interp2.intencao.assuntos.includes('emocional'));

const interp3 = interpretarConversa('Você se lembra de mim?', { historico: [] });
test('Memória: assunto', interp3.intencao.assuntos.includes('memoria'));

const interp4 = interpretarConversa('Me ajude com essa missão', { historico: [] });
test('Prático: assunto', interp4.intencao.assuntos.includes('pratico'));

const interp5 = interpretarConversa('Somos amigos, certo?', { historico: [] });
test('Relacional: assunto', interp5.intencao.assuntos.includes('relacional'));

const interp6 = interpretarConversa('kkkk que engraçado!', { historico: [] });
test('Tom brincalhão', interp6.tom.tomPredominante === 'brincalhao');

const interp7 = interpretarConversa('ISSO É INACEITÁVEL!', { historico: [] });
test('Tom irritado', interp7.tom.tomPredominante === 'irritado');

const interp8 = interpretarConversa('Por favor, pode me ajudar?', { historico: [] });
test('Pedido: intenção', interp8.intencao.tipoIntencao === 'pedido');

const interp9 = interpretarConversa('Qual é o melhor caminho?', { historico: [] });
test('Pergunta: intenção', interp9.intencao.ehPergunta === true);

// Teste com histórico (estágio)
const historico10 = Array(10).fill({ papel: 'jogador', conteudo: 'oi' });
const interp10 = interpretarConversa('Oi', { historico: historico10 });
test('Estágio desenvolvendo', interp10.estagio.estagio === 'desenvolvendo');

