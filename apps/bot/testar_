let pass = 0;
let fail = 0;

function test(nome, condicao, detalhes) {
    if (condicao) { pass++; console.log(`[PASS] ${nome}`); }
    else { fail++; console.log(`[FAIL] ${nome} ${detalhes ? '- ' + detalhes : ''}`); }
}

