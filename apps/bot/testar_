// TESTE EXTRAÇÃO DE CAMPOS SOB DEMANDA
// =============================================
console.log('\n=== TESTE EXTRAÇÃO CAMPOS ===');
const { extrairCamposSobDemanda } = require('./src/ia/cargaSobDemanda');

const npcTeste = {
    id: 'teste',
    nome: 'Teste',
    personalidade: 'Curioso e brilhante',
    historia: 'Professora de história arcana antes de seu Despertar...',
    objetivos: 'Catalogar dungeons anômalas',
    atributos: { forca: 22, inteligencia: 95 },
    classe: 'Mago Elemental',
    aparencia: 'Veste roupas acadêmicas desgastadas'
};

// Pergunta sobre história → deve carregar historia
const deteccaoHistoria = detectarCargaNecessaria('Me conte sua história');
const camposHistoria = extrairCamposSobDemanda(npcTeste, deteccaoHistoria);
test('História extraída', camposHistoria.historia !== undefined);
test('Classe não extraída p/ história', camposHistoria.classe === undefined);

// Pergunta sobre aspectos → deve carregar atributos + classe
const deteccaoAtributos = detectarCargaNecessaria('Quão forte você é?');
const camposAtributos = extrairCamposSobDemanda(npcTeste, deteccaoAtributos);
test('Atributos extraídos', camposAtributos.atributos !== undefined);
test('História não extraída p/ atributos', camposAtributos.historia === undefined);

