test('Técnicas', detectarCargaNecessaria('Como você luta?').tecnicas === true);
test('Equipamentos', detectarCargaNecessaria('Qual sua arma?').equipamentos === true);
test('Aparência', detectarCargaNecessaria('Como você se parece?').aparencia === true);
test('Gostos', detectarCargaNecessaria('O que você gosta de fazer?').gostos === true);
test('Traumas', detectarCargaNecessaria('Qual seu maior medo?').traumas === true);
