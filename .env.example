# Variáveis locais do projeto. Copie para .env e preencha somente na sua máquina.
# Nunca versione valores reais, nem use prefixo NEXT_PUBLIC_ para credenciais.
DATABASE_URL=
DATABASE_PROVIDER=postgres
# Necessario apenas se o pooler Supabase da sua rede apresentar certificado nao confiavel no Node.
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Opcional para Vercel/serverless; mantenha server-side.
DATABASE_URL_SERVERLESS=
SITE_BASE_URL=http://localhost:3000
SITE_URL=http://localhost:3000
DUNGEON_ANNOUNCEMENT_GROUP_ID=
# Modelo local usado pela assistente Paimon.
SYSTEM_ASSISTANT_MODEL=qwen3:4b-instruct-2507-q4_K_M

# Cardinal Core local (Fase 1, sem ferramentas administrativas)
CARDINAL_HOST=127.0.0.1
CARDINAL_PORT=8088
CARDINAL_CONTEXT_SIZE=16384
CARDINAL_GPU_LAYERS=20
CARDINAL_TIMEOUT_MS=0
CARDINAL_MAX_TOKENS=8192
# Preencha apenas se o GGUF já instalado não estiver no cache padrão.
CARDINAL_MODEL_PATH=
CARDINAL_ADMIN_WRITES_ENABLED=false
CARDINAL_CONFIRM_HIGH_RISK=true
CARDINAL_OWNER_NUMBER=
CARDINAL_DEVELOPER_ENABLED=false
CARDINAL_AUTO_COMMIT=false
CARDINAL_AUTO_MERGE=false
CARDINAL_MAX_FIX_ATTEMPTS=3
CARDINAL_REQUIRE_REVIEW=true
CARDINAL_ALLOW_DATABASE_MIGRATIONS=false
CARDINAL_CODE_CONTEXT_CHARS=24000
CARDINAL_WORKTREE_ROOT=
CARDINAL_OPERATIONS_ENABLED=false
CARDINAL_AUTO_DEPLOY_PRODUCTION=false
CARDINAL_OPS_CONFIRM_HIGH=true
CARDINAL_MAX_RESTART_ATTEMPTS=3
CARDINAL_RESTART_WINDOW_MS=600000
CARDINAL_BACKUP_KEEP_LAST=10
CARDINAL_MIN_DISK_FREE_MB=1024
CARDINAL_ORCHESTRATOR_ENABLED=false
CARDINAL_MODE=ASSISTED
CARDINAL_MAX_LLM_CONCURRENCY=1
CARDINAL_MAX_TASK_RETRIES=2
CARDINAL_MAX_WORKFLOW_TASKS=60
CARDINAL_MAX_REPLANS=2
CARDINAL_MAX_WORKFLOW_DEPTH=3
CARDINAL_MAX_WORKFLOW_RUN_MS=120000
CARDINAL_REQUIRE_PUBLICATION_APPROVAL=true
CARDINAL_REQUIRE_DEPLOY_APPROVAL=true
CARDINAL_MEMORY_ENABLED=true
CARDINAL_MEMORY_RAW_RETENTION_DAYS=14
CARDINAL_MEMORY_SESSION_TTL=86400000
CARDINAL_MEMORY_AUTO_SAVE_DECISIONS=true
CARDINAL_MEMORY_MAX_CONTEXT_ITEMS=8
CARDINAL_MEMORY_SUMMARIZATION_ENABLED=true
CARDINAL_WORLD_ENABLED=false
CARDINAL_WORLD_TIMEZONE=America/Sao_Paulo
CARDINAL_WORLD_ALLOW_ACTIVE_CONTENT_EDIT=false
CARDINAL_MAX_SIMULATION_ITERATIONS=10000
CARDINAL_BLOCK_CRITICAL_BALANCE_ISSUES=true
CARDINAL_BLOCK_HIGH_EXPLOITS=true
CARDINAL_WEB_ENABLED=true
CARDINAL_WEB_SEARCH_PROVIDER=searxng
CARDINAL_SEARXNG_URL=http://127.0.0.1:8888
CARDINAL_WEB_MAX_RESULTS=10
CARDINAL_WEB_MAX_FETCHES=5
CARDINAL_WEB_TIMEOUT_MS=10000
CARDINAL_WEB_CACHE_ENABLED=true
CARDINAL_WEB_CACHE_TTL=86400000
CARDINAL_VISION_ENABLED=false
CARDINAL_VISION_PROVIDER=disabled
CARDINAL_VISION_MAX_IMAGE_MB=8
CARDINAL_VISION_MAX_IMAGES=3
CARDINAL_VISION_MAX_RESOLUTION=1024
CARDINAL_VISION_CACHE_ENABLED=true
CARDINAL_VISION_REFERENCE_TTL=86400000
